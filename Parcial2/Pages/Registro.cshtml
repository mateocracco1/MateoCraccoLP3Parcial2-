@page
@model RegistroModel
@{
    ViewData["Title"] = "Registro de Clientes";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-person-fill-add me-2"></i>Alta de Cliente</h4>
                <small>Complete el formulario para acceder al sistema legal</small>
            </div>
            <div class="card-body p-4">

                <!-- Resumen de validación (ValidationSummary de Guía 07) -->
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <form method="post">
                    <div class="mb-3">
                        <label asp-for="NombreCompleto" class="form-label fw-semibold"></label>
                        <input asp-for="NombreCompleto" class="form-control" placeholder="Ej. Mateo Cracco" />
                        <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NombreUsuario" class="form-label fw-semibold"></label>
                        <input asp-for="NombreUsuario" class="form-control" placeholder="Ej. mateocracco" />
                        <span asp-validation-for="NombreUsuario" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label asp-for="Email" class="form-label fw-semibold"></label>
                            <input asp-for="Email" class="form-control" placeholder="cliente@correo.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Edad" class="form-label fw-semibold"></label>
                            <input asp-for="Edad" class="form-control" type="number" min="1" placeholder="Ej. 25" />
                            <span asp-validation-for="Edad" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold"></label>
                        <input asp-for="Password" class="form-control" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                        <input asp-for="ConfirmPassword" class="form-control" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg shadow-sm">
                            <i ></i>Registrar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}