<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Asesoria Legal Global</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
            body {
                display: flex;
                flex-direction: column;
                min-height: 100vh;
                background-color: #f4f6f9;
                color: #2c3e50;
            }
            .main-content {
                flex: 1;
            }
            .navbar-legal {
                background-color: #581845;
                border-bottom: 3px solid #c59b27;
            }
            .brand-text {
                font-weight: 700;
                letter-spacing: 0.5px;
                color: #ffffff !important;
            }
            .footer-legal {
                background-color: #3e1031;
                color: #adb5bd;
                border-top: 1px solid #1e3a5a;
            }
    </style>

    @RenderSection("Head", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-legal shadow-sm py-3">
            <div class="container">
                <a class="navbar-brand brand-text" asp-page="/Index">
                    <i class="bi bi-briefcase-fill text-warning me-2"></i>Asesoría Legal Global
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navLegal">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navLegal">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 gap-2">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-page="/Index">
                                <i class="bi bi-house me-1"></i>Inicio
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-page="/Registro">
                                <i ></i>Registro de Clientes
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-page="/Documentos">
                                <i ></i>Gestión de Documentos
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="main-content container py-4">
        @RenderBody()
    </main>

    <footer class="footer-legal text-center py-3 mt-auto">
        <div class="container">
            <p class="mb-1 fw-semibold">Asesoría Legal Global &copy; 2026 - Todos los derechos reservados</p>
            <small class="text-secondary">Consultoría jurídica integral y resguardo seguro de expedientes</small>
        </div>
    </footer>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>