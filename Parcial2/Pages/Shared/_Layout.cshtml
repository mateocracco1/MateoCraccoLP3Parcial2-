<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Asesoría Legal Global</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            background-color: #f7f7f9;
            color: #212529;
            font-family: system-ui, -apple-system, sans-serif;
        }
        .main-content {
            flex: 1;
        }
        .navbar-legal {
            background-color: #581845;
            border-bottom: 2px solid #900c3f;
        }
        .navbar-brand {
            font-weight: 700;
            letter-spacing: 0.5px;
            color: #ffffff !important;
        }
        .nav-link {
            color: #f8f9fa !important;
        }
        .nav-link:hover {
            color: #e2d4dc !important;
        }
        .footer-legal {
            background-color: #3e1031;
            color: #d1c4cd;
            border-top: 1px solid #581845;
        }
    </style>

    @RenderSection("Head", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-legal py-3">
            <div class="container">
                    <a class="navbar-brand text-uppercase d-flex align-items-center gap-2" asp-page="/Index">
                        <img src="~/imagenes/logo 1.png" alt="Logo Asesoría Legal" height="35" class="rounded" />
                        <span>Asesoría Legal Global</span>
                    </a>              
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navLegal">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navLegal">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Registro">Registro de Clientes</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Documentos">Gestión de Documentos</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="main-content container py-4">
        @RenderBody()
    </main>

 <footer class="footer-legal py-3 mt-auto">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
            <div>
                <img src="~/imagenes/logo 2.png" alt="Sello Legal 1" height="40" class="opacity-75" />
            </div>
            <div class="text-center">
                <p class="mb-1">Asesoría Legal Global &copy; 2026 </p>
                <small>Consultoría jurídica y resguardo de expedientes</small>
            </div>
            <div>
                <img src="~/imagenes/logo 3.png" alt="Sello Legal 2" height="40" class="opacity-75" />
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>