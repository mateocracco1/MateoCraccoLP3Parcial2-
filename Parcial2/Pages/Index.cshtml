@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}

<div class="p-5 mb-4 bg-white rounded-3 border text-center">
    <div class="container-fluid py-3">
        <h1 class="display-6 fw-bold mb-3">Portal de Servicios Jurídicos</h1>
        <p class="col-md-8 mx-auto fs-5 text-muted">
            Bienvenido a la plataforma de <strong>Asesoría Legal Global</strong>. Registre sus datos y gestione sus documentos legales de manera directa.
        </p>
        <div class="d-flex justify-content-center gap-3 mt-4">
            <a class="btn btn-primary btn-lg px-4" asp-page="/Registro">Registrarse</a>
            <a class="btn btn-outline-secondary btn-lg px-4" asp-page="/Documentos">Espacio de Documentos</a>
        </div>
    </div>
</div>