@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}

<div class="p-5 mb-4 bg-white rounded-3 shadow-sm border text-center">
    <div class="container-fluid py-3">
        <h1 class="display-6 fw-bold text-primary mb-3">Portal de Servicios Jurídicos</h1>
        <p class="col-md-8 mx-auto fs-5 text-muted">
            Bienvenido a la plataforma digital de <strong>Asesoría Legal Global</strong>. Facilite su alta de cliente y gestione sus documentos legales de manera ágil y segura.
        </p>
        <div class="d-flex justify-content-center gap-3 mt-4">
            <a class="btn btn-primary btn-lg px-4" asp-page="/Registro">
                <i class="bi bi-person-plus me-1"></i>Registrarse
            </a>
            <a class="btn btn-outline-secondary btn-lg px-4" asp-page="/Documentos">
                <i class="bi bi-folder2-open me-1"></i>Espacio de Documentos
            </a>
        </div>
    </div>
</div>